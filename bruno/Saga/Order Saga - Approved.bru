meta {
  name: Order Saga - Approved
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/orders/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "customerNumber": "CUST-SAGA-APPROVED-001",
    "amount": 499.00
  }
}

assert {
  res.status: eq 202
  res.body.customerNumber: eq CUST-SAGA-APPROVED-001
  res.body.amount: eq 499
  res.body.orderId: isDefined
}

